# Test Environment Variables
# Copy this file to .env.test for running tests

# Google Drive Configuration
GDRIVE_SOURCE_FOLDER_ID=test-source-folder-id
GDRIVE_FOLDER_ID=test-target-folder-id
GDRIVE_PROCESSED_FOLDER_ID=test-processed-folder-id

# Watch Configuration
WATCH_POLL_INTERVAL=60000

# iFirma API Configuration (for integration tests)
IFIRMA_USERNAME=test-username
IFIRMA_INVOICE_KEY=test-invoice-key
IFIRMA_USER_KEY=test-user-key

# Webhook Configuration (for integration tests)
WEBHOOK_URL=http://localhost:3000/webhook
WEBHOOK_SECRET=test-secret-key
PORT=3000